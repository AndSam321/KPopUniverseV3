#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Database migration and seeding run in Render's pre-deploy command
# (./bin/rails db:prepare && ./bin/rails db:seed), not here. Keeping them out of
# the container start means they run once per deploy instead of on every boot,
# so a crash-recovery restart no longer re-runs the seed under memory pressure.

exec "${@}"
