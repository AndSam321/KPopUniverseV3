<% frontend = ENV["FRONTEND_URL"].presence || "http://localhost:5173" %>
<% reset_url = "#{frontend}/reset-password?reset_password_token=#{@token}" %>

<div style="font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; max-width: 480px; margin: 0 auto; color: #2b2540;">
  <h1 style="font-size: 20px; color: #5b53b0;">Reset your password</h1>

  <p>Hi <%= @resource.username.presence || "there" %>,</p>

  <p>We got a request to reset your K-pop Universe password. Click the button below to choose a new one. This link expires in a few hours.</p>

  <p style="margin: 28px 0;">
    <a href="<%= reset_url %>"
       style="background: #757bc8; color: #ffffff; text-decoration: none; padding: 12px 22px; border-radius: 999px; font-weight: 700; display: inline-block;">
      Reset my password
    </a>
  </p>

  <p style="font-size: 13px; color: #6b647f;">
    If the button doesn't work, copy and paste this link into your browser:<br>
    <a href="<%= reset_url %>" style="color: #757bc8; word-break: break-all;"><%= reset_url %></a>
  </p>

  <p style="font-size: 13px; color: #6b647f;">If you didn't request this, you can safely ignore this email — your password won't change.</p>
</div>
