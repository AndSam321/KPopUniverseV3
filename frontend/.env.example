# Backend API base URL (defaults to http://localhost:9000/api/v1 if unset)
VITE_API_URL=http://localhost:9000/api/v1

# ActionCable WebSocket URL (defaults to ws://localhost:9000/cable if unset)
VITE_CABLE_URL=ws://localhost:9000/cable

# Giphy Web API key for the comment GIF picker.
# Create an "API" app at https://developers.giphy.com/dashboard/ and paste the key here.
# Leave blank to disable the GIF picker (it degrades gracefully).
VITE_GIPHY_API_KEY=
